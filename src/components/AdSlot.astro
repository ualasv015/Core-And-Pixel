---
const { label = 'Ad space · reserved' } = Astro.props;
---

<div class="ad-slot" role="note" aria-label="Reserved advertising space">
  <span>{label}</span>
</div>

<style>
  .ad-slot { min-height: 3.4rem; display: grid; place-items: center; margin: 1.5rem 0; border: 1px dashed #C9D5D5; border-radius: .6rem; background: #F0F4F2; color: var(--muted); font-size: .62rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
</style>
