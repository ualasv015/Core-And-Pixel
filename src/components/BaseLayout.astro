---
import '../styles/global.css';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { sectionLabels, type GuideSection } from '../data/guides';

interface Breadcrumb { label: string; href?: string }
interface Props {
  title: string;
  description: string;
  currentPath?: string;
  noindex?: boolean;
  breadcrumbs?: Breadcrumb[];
  article?: { headline: string; description: string; path: string; section: GuideSection };
}

const { title, description, currentPath = '', noindex = false, breadcrumbs = [], article } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const shouldNoindex = noindex || !Astro.site || import.meta.env.PUBLIC_INDEXING_ENABLED !== 'true';
const breadcrumbItems = breadcrumbs.length ? [
  { name: 'Home', item: Astro.site ? new URL('/', Astro.site).toString() : '/' },
  ...breadcrumbs.map((crumb) => ({ name: crumb.label, ...(crumb.href ? { item: Astro.site ? new URL(crumb.href, Astro.site).toString() : crumb.href } : {}) })),
] : [];
const breadcrumbJsonLd = Astro.site && breadcrumbItems.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    ...(crumb.item ? { item: crumb.item } : {}),
  })),
} : undefined;
const articleJsonLd = article && !shouldNoindex ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.headline,
  description: article.description,
  mainEntityOfPage: canonical,
  articleSection: sectionLabels[article.section],
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: 'Core & Pixel' },
} : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={shouldNoindex ? 'noindex, nofollow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F7F8F5" />
    <title>{title} | Core &amp; Pixel</title>
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
    {articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
  </head>
  <body>
    <SiteHeader currentPath={currentPath} />
    <main id="main" class="shell"><slot /></main>
    <SiteFooter />
  </body>
</html>
