---
interface Crumb { label: string; href?: string }
const { items }: { items: Crumb[] } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => <li>
      {item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
    </li>)}
  </ol>
</nav>

<style>
  .breadcrumbs { margin: .9rem 0 1.6rem; }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: .45rem; margin: 0; padding: 0; list-style: none; color: var(--muted); font-size: .72rem; }
  .breadcrumbs li + li::before { content: '/'; margin-right: .45rem; color: #9BA9AE; }
  .breadcrumbs a { color: inherit; text-decoration: none; }
  .breadcrumbs a:hover { color: var(--teal-dark); text-decoration: underline; }
</style>
