---
import Logo from './Logo.astro';
import { navItems } from '../data/navigation';
const { currentPath = '' } = Astro.props;
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <Logo />
    <nav class="desktop-nav" aria-label="Main navigation">
      {navItems.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Open navigation menu">Menu</summary>
      <nav aria-label="Mobile navigation">
        {navItems.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<style>
  .skip-link { position: absolute; left: 1rem; top: -5rem; z-index: 20; padding: .75rem 1rem; background: var(--navy); color: white; border-radius: .5rem; }
  .skip-link:focus { top: 1rem; }
  .site-header { background: var(--white); border-bottom: 1px solid var(--line); }
  .header-inner { width: min(100% - 3rem, 70rem); min-height: 4.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-inline: auto; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(1.15rem, 3vw, 2.75rem); }
  .desktop-nav a, .mobile-nav a { color: var(--body); font-size: .78rem; font-weight: 650; text-decoration: none; }
  .desktop-nav a:hover, .desktop-nav a[aria-current="page"], .mobile-nav a:hover { color: var(--teal-dark); }
  .desktop-nav a[aria-current="page"]::after { display: block; width: 1.2rem; height: 2px; margin: .35rem auto -.45rem; background: var(--teal); content: ''; }
  .mobile-nav { display: none; position: relative; }
  .mobile-nav summary { list-style: none; cursor: pointer; color: var(--teal-dark); font-size: .75rem; font-weight: 800; text-transform: uppercase; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav nav { position: absolute; z-index: 10; right: 0; top: calc(100% + .9rem); min-width: 12rem; padding: .5rem; background: var(--white); border: 1px solid var(--line); border-radius: .8rem; box-shadow: var(--shadow); }
  .mobile-nav a { display: block; padding: .75rem; border-radius: .45rem; }
  @media (max-width: 760px) {
    .header-inner { width: min(100% - 2rem, 70rem); min-height: 4rem; }
    .desktop-nav { display: none; }
    .mobile-nav { display: block; }
  }
</style>
