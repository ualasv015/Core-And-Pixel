---
import BaseLayout from '../components/BaseLayout.astro';
const description = 'The page may have moved or the address may be incorrect.';
---

<BaseLayout title="Page not found" description={description} noindex>
  <section class="page-hero"><p class="kicker">404 · Page not found</p><h1>We could not find that page.</h1><p>{description}</p><p><a class="button" href="/">Return to the home page</a></p></section>
</BaseLayout>
