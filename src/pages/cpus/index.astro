---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { guidePlan } from '../../data/guides';

const entries = await getCollection('guides');
const available = new Map(entries.map((entry) => [entry.data.path, entry.data.status] as const));
const guides = guidePlan.filter((guide) => guide.section === 'cpus' && !['G03'].includes(guide.id));
---

<BaseLayout title="CPU guides and explainers" description="Understand CPU cores, threads, clock speed, performance tests and platform choices with clear beginner-friendly guides." currentPath="/cpus/" breadcrumbs={[{ label: 'CPUs' }]}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'CPUs' }]} />
  <section class="page-hero"><p class="kicker">CPUs</p><h1>Understand your CPU. Choose with confidence.</h1><p>Learn what processor specifications mean, compare platforms by workload and check the full cost before you upgrade.</p><div class="actions"><a class="button" href="/cpus/cores-vs-threads/">Start with CPU basics</a><a class="text-link" href="/cpus/performance-rankings/">See the ranking methodology →</a></div></section>
  <section class="section-block"><h2 class="section-heading">Browse by task</h2><p class="section-intro">Start with the question you are trying to answer.</p><div class="grid-3 task-grid"><GuideCard title="Learn the basics" description="Cores, threads, clock speed and cache." href="/cpus/cores-vs-threads/" label="Learn" /><GuideCard title="Compare processors" description="Intel vs. AMD and workload-based rankings." href="/cpus/performance-rankings/" label="Compare" accent="amber" /><GuideCard title="Choose or upgrade" description="Budget, motherboard support and upgrade paths." label="Buy / upgrade" /></div></section>
  <section class="section-block"><div class="section-title-row"><div><h2 class="section-heading">CPU guides</h2><p class="section-intro">Draft articles and topics in the launch plan.</p></div></div><div class="grid-3">{guides.map((guide, index) => <GuideCard title={guide.title} description={guide.intent} href={available.has(guide.path) ? guide.path : undefined} label={available.get(guide.path) === 'review' ? 'Draft · owner review' : available.get(guide.path) === 'published' ? 'Reviewed guide' : 'Planned guide'} accent={index % 3 === 1 ? 'amber' : 'teal'} />)}</div></section>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.3rem; margin-top: 1.2rem; }
  .text-link { font-size: .8rem; font-weight: 800; text-decoration: none; }
  .task-grid { margin-top: 1rem; }
  .section-title-row { margin-bottom: 1rem; }
</style>
