---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
---

<BaseLayout title="Desktop CPU performance ranking" description="A ranking layout for separate gaming, productivity and value results, with sources, conditions and price context visible." currentPath="/cpus/" noindex breadcrumbs={[{ label: 'CPUs', href: '/cpus/' }, { label: 'Performance rankings' }]}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'CPUs', href: '/cpus/' }, { label: 'Performance rankings' }]} />
  <section class="page-hero"><p class="kicker">CPU rankings</p><h1>Desktop CPU performance ranked by workload</h1><p>Gaming and productivity results belong in separate categories. Every row must link to its test source and conditions.</p></section>
  <aside class="method-bar"><div><strong>How this page is built</strong><p>Multiple attributable test sources · comparable workloads · source dates · limits explained</p></div><a class="button button--secondary" href="/how-we-rank/">Read our ranking method</a></aside>
  <div class="category-pills" aria-label="Ranking categories"><span>Gaming</span><span>Productivity</span><span>Value</span></div>
  <section class="section-block"><h2 class="section-heading">Gaming results</h2><p class="section-intro">Example layout · no verified product results are published yet.</p>
    <div class="table-wrap"><table class="data-table"><caption class="sr-only">CPU gaming ranking placeholder table with US and euro-area prices</caption><thead><tr><th scope="col">Rank</th><th scope="col">Processor</th><th scope="col">Test category</th><th scope="col">US price</th><th scope="col">EUR price</th><th scope="col">Evidence</th></tr></thead><tbody>
      {['1080p gaming', '1440p gaming', '4K gaming'].map((category) => <tr><td class="empty-cell">—</td><td class="empty-cell">No verified result</td><td>{category}</td><td class="empty-cell">$ —</td><td class="empty-cell">€ —</td><td class="empty-cell">Source, suite and date pending</td></tr>)}
    </tbody></table></div>
  </section>
  <div class="price-note"><strong>Price context</strong><p>US and euro-area prices will be checked separately by store and country. EUR will not be calculated by converting a US listing.</p></div>
  <AdSlot />
  <p class="muted"><small>No ranking conclusion is available until test sources can be compared fairly. User-submitted benchmark data may be supplementary context, never the sole basis for a ranking.</small></p>
</BaseLayout>

<style>
  .method-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.1rem; border-radius: .7rem; background: var(--mist); }
  .method-bar strong { color: var(--teal-dark); font-size: .68rem; text-transform: uppercase; letter-spacing: .07em; }
  .method-bar p { margin: .35rem 0 0; color: var(--navy); font-size: .8rem; font-weight: 700; }
  .category-pills { display: flex; gap: .55rem; margin: 1.2rem 0; }
  .category-pills span { padding: .4rem .8rem; border-radius: 999px; background: var(--white); color: var(--body); font-size: .7rem; font-weight: 800; }
  .category-pills span:first-child { background: var(--teal); color: var(--white); }
  .price-note { padding: 1rem; border-radius: .55rem; background: #FFF5E1; }
  .price-note strong { color: var(--navy); font-size: .74rem; text-transform: uppercase; }
  .price-note p { margin: .3rem 0 0; color: var(--body); font-size: .8rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 620px) { .method-bar { align-items: flex-start; flex-direction: column; } }
</style>
