---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { guidePlan } from '../../data/guides';
const entries = await getCollection('guides');
const available = new Map(entries.map((entry) => [entry.data.path, entry.data.status] as const));
const guides = guidePlan.filter((guide) => guide.section === 'gpus' && guide.id !== 'G04');
---

<BaseLayout title="GPU guides and explainers" description="Learn how to compare graphics cards by resolution, VRAM, rendering features, compatibility and market-specific prices." currentPath="/gpus/" breadcrumbs={[{ label: 'GPUs' }]}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'GPUs' }]} />
  <section class="page-hero"><p class="kicker">GPUs</p><h1>Choose a graphics card for the games you play.</h1><p>Understand resolution, VRAM and rendering features before comparing a GPU to your monitor, budget and PC.</p><div class="actions"><a class="button" href="/gpus/performance-rankings/">Explore the ranking layout</a><a class="text-link" href="/how-we-rank/">How evidence is handled →</a></div></section>
  <section class="section-block"><h2 class="section-heading">Browse by task</h2><div class="grid-3 task-grid"><GuideCard title="Choose by resolution" description="Match a card to 1080p, 1440p or 4K gaming." href="/gpus/choose-by-resolution/" label="Choose" /><GuideCard title="Understand VRAM" description="See how graphics memory needs vary by game and settings." href="/gpus/how-much-vram/" label="Learn" accent="amber" /><GuideCard title="Plan an upgrade" description="Check dimensions, power and connectors before buying." href="/gpus/gpu-upgrade-compatibility/" label="Check" /><GuideCard title="Compare NVIDIA and AMD" description="See how the current GeForce and Radeon cards differ by price and workload." href="/gpus/nvidia-vs-amd/" label="Compare" accent="amber" /></div></section>
  <section class="section-block"><h2 class="section-heading">GPU guides</h2><p class="section-intro">Draft articles and topics in the launch plan.</p><div class="grid-3 planned-grid">{guides.map((guide, index) => <GuideCard title={guide.title} description={guide.intent} href={available.has(guide.path) ? guide.path : undefined} label={available.get(guide.path) === 'review' ? 'Draft · owner review' : available.get(guide.path) === 'published' ? 'Reviewed guide' : 'Planned guide'} accent={index % 2 ? 'amber' : 'teal'} />)}</div></section>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; margin-top: 1.2rem; }
  .text-link { font-size: .8rem; font-weight: 800; text-decoration: none; }
  .task-grid, .planned-grid { margin-top: 1rem; }
</style>
